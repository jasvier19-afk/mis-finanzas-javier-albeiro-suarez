rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'baseMonthlyBudget',
          'hasConfiguredBudget',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'baseMonthlyBudget',
          'hasConfiguredBudget',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.baseMonthlyBudget is number
        && data.baseMonthlyBudget >= 0
        && data.baseMonthlyBudget <= 100000000
        && data.hasConfiguredBudget is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOptionalMovementFields(data) {
      return (!data.keys().hasAny(['paymentMethod']) || (data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 40))
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidMovement(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'type',
          'day',
          'dateLabel',
          'isoDate',
          'category',
          'description',
          'amount',
          'createdAtOrder',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'type',
          'day',
          'dateLabel',
          'isoDate',
          'category',
          'description',
          'amount',
          'paymentMethod',
          'notes',
          'createdAtOrder',
          'createdAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.type is string
        && data.type.size() <= 16
        && (data.type == 'expense' || data.type == 'income')
        && data.day is number
        && data.day >= 1
        && data.day <= 31
        && data.dateLabel is string
        && data.dateLabel.size() >= 1
        && data.dateLabel.size() <= 32
        && data.isoDate is string
        && data.isoDate.size() == 10
        && data.isoDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 60
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 120
        && data.amount is number
        && data.amount > 0
        && data.amount <= 100000000
        && data.createdAtOrder is number
        && data.createdAtOrder >= 0
        && data.createdAt is timestamp
        && isValidOptionalMovementFields(data)
        && (
          data.type == 'income' ||
          data.category in [
            'Alimentación',
            'Transporte',
            'Servicios públicos',
            'Ropa y compras personales',
            'Entretenimiento y ocio'
          ]
        );
    }

    // --- Collection Rules ---
    match /users/{userId} {
      // PII strictly restricted to the owner; no list scraping allowed
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['baseMonthlyBudget', 'hasConfiguredBudget', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['baseMonthlyBudget', 'hasConfiguredBudget', 'displayName', 'updatedAt'])
        );

      allow delete: if false;

      match /movements/{movementId} {
        allow get: if isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId)
          && isValidMovement(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId)
          && isValidMovement(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'day',
            'dateLabel',
            'isoDate',
            'category',
            'description',
            'amount',
            'paymentMethod',
            'notes'
          ])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
